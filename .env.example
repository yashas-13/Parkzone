# ParkZone backend environment - copy to .env and fill in. NEVER commit .env

# MongoDB Atlas connection string (least-privilege app user, not an admin user)
MONGO_URI=mongodb+srv://parkzone_app:<PASSWORD>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=parkzone

# Public domain - single domain only, never a subdomain
PARKZONE_DOMAIN=parkzone.in

# Comma-separated exact origins allowed to call the API (no wildcards in prod)
PZ_CORS_ORIGINS=https://parkzone.in

# Comma-separated docker images renters may deploy
PZ_ALLOWED_IMAGES=pytorch/pytorch,tensorflow/tensorflow:latest-gpu,nvidia/cuda:12.1.0-base-ubuntu22.04

# Dev-only escape hatches. Set PZ_DEV_MODE=false in production.
PZ_DEV_MODE=true
# Required header value for /api/wallet/add when PZ_DEV_MODE=false (Razorpay webhook secret)
PZ_ADMIN_TOKEN=change-me

# First port handed out to new instances (must be free on the VPS)
PZ_SSH_PORT_BASE=22001
PZ_JUPYTER_PORT_BASE=8901

# Comma-separated allowed host ids for /api/stop ownership checks (leave blank to skip)
PZ_LOG_LEVEL=INFO
